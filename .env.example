# Copy this file to .env and replace every placeholder before running the app.
# Never commit .env; it is ignored by Git.

# App environment: use production only with a strong secret and a real AI adapter.
ENVIRONMENT=development
# Python logging level.
LOG_LEVEL=INFO
# Exact browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Set false in production if interactive API documentation is not needed.
DOCS_ENABLED=true
# Maximum declared /chat request body size in bytes.
MAX_CHAT_BODY_BYTES=10240

# SQLAlchemy URL for non-Docker runs; Docker Compose replaces this with the db service URL.
DATABASE_URL=postgresql://chatbot:replace-this-password@localhost:5432/chatbot_db
# PostgreSQL username used by the db container.
POSTGRES_USER=chatbot
# PostgreSQL password used by the db container; replace this placeholder.
POSTGRES_PASSWORD=replace-this-password
# PostgreSQL database name used by the db container.
POSTGRES_DB=chatbot_db

# Random JWT signing key; use at least 32 random characters in production.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# JWT lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Directory where validated uploads are stored; Docker sets this to /app/uploads.
UPLOAD_DIR=./uploads
# Maximum individual upload size in megabytes.
MAX_UPLOAD_MB=10

# AI adapter mode: dummy for development, http or module for Student 1 integration.
AI_MODE=dummy
# HTTP adapter base URL; required when AI_MODE=http.
AI_BASE_URL=
# AI adapter request timeout in seconds.
AI_TIMEOUT_SECONDS=30
# Dotted Python module path; required when AI_MODE=module.
AI_MODULE_PATH=

# Admin seed display name; required by the explicit create_admin command.
ADMIN_NAME=Admin User
# Admin seed email; required by the explicit create_admin command.
ADMIN_EMAIL=admin@example.com
# Admin seed password; replace this placeholder before seeding.
ADMIN_PASSWORD=replace-this-admin-password
