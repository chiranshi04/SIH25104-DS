# Yeh sirf example file hai. Copy karke ".env" banao aur values fill karo.
# .env kabhi bhi git mein commit mat karna.

ENVIRONMENT=development

# Phase 6 mein use hoga (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/chatbot_db

# Phase 8 mein use hoga
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Phase 8 admin seed ke liye values fill karo
ADMIN_NAME="Admin User"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
